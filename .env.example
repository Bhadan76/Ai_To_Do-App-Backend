# Required by the existing Prisma PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Optional application settings (defaults shown)
NODE_ENV=development
PORT=3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
REFRESH_TOKEN_TTL_DAYS=30

# Required for access-token signing; use a unique random value of 32+ bytes.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL=15m

# Comma-separated browser origins. Required when NODE_ENV=production.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Gemini AI configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=30000
