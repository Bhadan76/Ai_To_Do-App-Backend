    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    const data = response.data || response;",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', data.accessToken);",
                  "        console.log('Saved accessToken to collectionVariables');",
                  "    }",
                  "    if (data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "        console.log('Saved refreshToken to collectionVariables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"alex.morgan@example.com\",\n  \"password\": \"A-strong-passphrase-2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account. On 201 Created, sets `accessToken` and `refreshToken` in collection variables."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
